# ---------------------------------------------------------------------------
# Free AI video providers. Everything below is OPTIONAL.
#
# Hugging Face Spaces needs no key at all — with an empty .env the app already
# renders every beat on the four image-to-video Spaces, anonymously. The other
# keys each add a provider with its own separate free allowance, and requests
# are attempted down the pool in order until one succeeds, so more keys means
# fewer declined generations.
#
#   HUGGING_FACE_TOKEN  OPTIONAL. Free account at https://huggingface.co/join
#                       Token at https://huggingface.co/settings/tokens (read scope)
#                       Only needed if anonymous runs start getting refused.
#
#   NOVITA_API_KEY      Free account + signup credits at https://novita.ai
#                       Keys: https://novita.ai/settings/key-management
#
#   MAGIC_HOUR_API_KEY  Free tier credits at https://magichour.ai/developer
#
#   REPLICATE_API_TOKEN  Free test runs (no card) at https://replicate.com
#                        Token: https://replicate.com/account/api-tokens
#                        Runs minimax/video-01 image-to-video from the
#                        "try for free" collection, 6s clips.
#
#   AGNES_API_KEY        Free trial model at https://platform.agnes-ai.com
#                        agnes-video-2.5-flash is $0/second (720P, ~1/min).
#
#   ATMEE_API_KEY        Free plan renders clips at https://www.atmee.ai
#                        Key: https://www.atmee.ai/dashboard (generation:write)
# ---------------------------------------------------------------------------
HUGGING_FACE_TOKEN=
NOVITA_API_KEY=
MAGIC_HOUR_API_KEY=
REPLICATE_API_TOKEN=
AGNES_API_KEY=
ATMEE_API_KEY=

# Local motion renderer (ffmpeg Ken Burns pass on the photo). Always available,
# and used only if every AI provider in the pool declines the request.
ENABLE_LOCAL_FALLBACK=true

# Providers that require a URL instead of an upload get the photo from a free
# no-account host (catbox, falling back to tmpfiles). Set this to reuse a host
# of your own: the photo is served from <override>/<filename>.
PUBLIC_IMAGE_URL_OVERRIDE=

# Server
PORT=3000

# Dev preview proxy hostname (set automatically by the cloud workspace)
# PREVIEW_HOSTNAME=example.style.dev
